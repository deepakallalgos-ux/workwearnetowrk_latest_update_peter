========================================================================== */
#pjWrapper .pjScEmptyCategoryMessage {
	padding: 0 15px;
}

#pjWrapper .pjScProduct .pjScProductImage {
	margin: 0 auto;
	width: 100%;
}

#pjWrapper label.scError {
	color: #a94442 !important;
	font-weight: normal !important;
}

#pjWrapper .scMaximumItems {
	display: none;
}

